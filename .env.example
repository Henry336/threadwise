# Required
TELEGRAM_BOT_TOKEN=
# Runtime URL. Supabase shared-pooler URLs are moved to transaction mode automatically.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/threadwise
# Optional but recommended: direct or Supabase session-pooler URL used only by Prisma migrations.
DIRECT_URL=
DATABASE_CONNECTION_LIMIT=3
DATABASE_POOL_TIMEOUT_SECONDS=30
SUPABASE_RUNTIME_POOL_MODE=auto

# Optional server-side content encryption. Leave off until a verified backup
# exists and the migration command has been rehearsed. Generate the key once
# with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONTENT_ENCRYPTION_MODE=off
CONTENT_ENCRYPTION_KEY=

# Optional for AI-assisted classification and synthesis features.
# Without this, Threadwise falls back to deterministic local heuristics.
OPENAI_API_KEY=

# Optional
OPENAI_MODEL=gpt-5.4-mini
# Comma-separated chat model fallback chain used after rate-limit or model availability errors.
# Put any preferred stronger model first, then cheaper/lower models after it.
OPENAI_MODEL_FALLBACKS=gpt-5.5,gpt-5.4,gpt-5.4-nano
# Study module review runs asynchronously on the backend with the same OpenAI
# credential and model chain. These bounds keep jobs leased and restart-safe.
STUDY_ANALYSIS_POLL_MS=10000
STUDY_ANALYSIS_TIMEOUT_MS=90000
STUDY_ANALYSIS_LEASE_SECONDS=180
STUDY_ANALYSIS_MAX_OUTPUT_TOKENS=8192
# Enables private /admin/ai/status and /admin/reminders/* endpoints. Use a long random secret you create yourself.
# Send it as an Authorization Bearer token or x-threadwise-admin-token header.
ADMIN_STATUS_TOKEN=
# Optional. Overrides the production web dashboard opened by Telegram's persistent Dashboard button.
DASHBOARD_URL=https://threadwise-dashboard.vercel.app
PORT=3000
WEBHOOK_URL=
WEBHOOK_SECRET_PATH=/telegram/webhook

# Beacon community bot. This is a second Telegram identity running inside the
# same Render process. Leave BEACON_BOT_TOKEN blank to disable it completely.
# Keep the token and IDs in Render secrets; never paste the token into chat.
BEACON_BOT_TOKEN=
BEACON_OWNER_TELEGRAM_ID=5969845149
# Configure the private testing group first. The production group may remain
# blank until Beacon is ready to be added there.
BEACON_TEST_CHAT_ID=
BEACON_PRODUCTION_CHAT_ID=
# Optional private Telegram moderator room. When blank, reports and permission
# audits are delivered to the owner's private chat with Beacon.
BEACON_MODERATOR_CHAT_ID=
BEACON_WEBHOOK_SECRET_PATH=/telegram/beacon-webhook
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional when WEBHOOK_URL is set; otherwise use https://YOUR_HOST/calendar/oauth/callback.
GOOGLE_CALENDAR_REDIRECT_URI=
# Use a long random secret. This encrypts each user's Google Calendar OAuth tokens.
GOOGLE_TOKEN_ENCRYPTION_KEY=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Frozen compatibility surface: Expenses/Excel are hidden from the active product.
# Keep these blank unless deliberately testing the retained implementation.
# Optional when WEBHOOK_URL is set; otherwise use https://YOUR_HOST/excel/oauth/callback.
MICROSOFT_REDIRECT_URI=
# Use a long random secret. This encrypts each user's Microsoft OAuth tokens in the database.
MICROSOFT_TOKEN_ENCRYPTION_KEY=
REMINDER_POLL_MS=60000
DEFAULT_TIMEZONE=Asia/Singapore
DEFAULT_REMINDER_INTERVAL_MINUTES=180
DEFAULT_QUIET_HOURS_START=22:00
DEFAULT_QUIET_HOURS_END=08:00
# This is a global Threadwise allowlist, not a Codex-mode setting. Leave blank unless the whole bot should be restricted.
BOT_ALLOWED_TELEGRAM_IDS=

# Private Study Mode. It is completely disabled unless both values are set.
# Use your numeric human Telegram user ID, not a username. The chat must be the
# one exact private group/supergroup where /study bind will be run.
STUDY_OWNER_TELEGRAM_ID=
STUDY_ALLOWED_CHAT_ID=
# NUS Canvas access token. Threadwise uses it only for read operations. Store
# it only as a Render secret; never paste it into Telegram or commit its value.
CANVAS_ACCESS_TOKEN=
CANVAS_BASE_URL=https://canvas.nus.edu.sg/api/v1
STUDY_CANVAS_SYNC_INTERVAL_MINUTES=30
# Public Improved NextBus deployment used for venue/route estimates.
STUDY_TRANSIT_BASE_URL=https://improved-nextbus.vercel.app
STUDY_EXTERNAL_REQUEST_TIMEOUT_MS=12000
# Optional owner-operated production smoke seed. Set only to today's local
# YYYY-MM-DD date; it is ignored on other dates and blocks are Week-scoped.
STUDY_SMOKE_TEST_DATE=

# Private Codex mode. It is completely disabled unless all three values are set.
# CODEX_OWNER_TELEGRAM_ID is the only Telegram account allowed to invoke it.
# CODEX_TELEGRAM_CHAT_ID is the only chat where it exists.
CODEX_OWNER_TELEGRAM_ID=
CODEX_TELEGRAM_CHAT_ID=
# Shared secret used only between Render and your local Windows worker (24+ characters).
CODEX_WORKER_TOKEN=
CODEX_JOB_LEASE_SECONDS=3600
# Cloud-side ceiling for /files transfers. The standard Telegram Bot API currently
# accepts files up to 50,000,000 bytes; lower this if the deployment needs a tighter cap.
FILE_COURIER_MAX_BYTES=50000000
# Voice Capture. OpenAI accepts transcription uploads up to 25 MB, while Telegram's
# hosted Bot API can download files only up to 20 MB, so 20 MB is the safe default.
VOICE_TRANSCRIPTION_MAX_BYTES=20000000
VOICE_TRANSCRIPTION_LEASE_SECONDS=300

# Local worker only. Do not set these on Render.
THREADWISE_CODEX_URL=https://YOUR-THREADWISE-SERVICE.onrender.com
THREADWISE_CODEX_WORKER_TOKEN=
CODEX_WORKER_ID=my-laptop
CODEX_WORKER_POLL_MS=3000
CODEX_WORKER_SYNC_MS=300000
CODEX_WORKER_HEARTBEAT_MS=30000
CODEX_WORKER_NETWORK_ACCESS=false
CODEX_WORKER_MAX_ATTACHMENT_BYTES=26214400
# Persistent desktop Codex state. Set at Windows User scope for startup tasks.
CODEX_HOME=
# Extra directories a Codex task may access only after one-task Telegram approval.
# This is separate from THREADWISE_FILE_ROOTS and never defaults to a full drive.
# On Windows, configured volume roots authorize exact absolute paths quoted in a
# prompt; Threadwise passes those paths instead of the volume root to Codex because
# the Windows workspace sandbox cannot initialize with C:\ or D:\ as --add-dir.
THREADWISE_CODEX_ADDITIONAL_ROOTS=
# Optional credential names required by configured Codex MCP/plugin integrations.
# Values remain laptop-only and are excluded from model-run shell environments.
CODEX_WORKER_CREDENTIAL_ENV_ALLOWLIST=
# Optional root for disposable publish worktrees. Defaults to the Windows temp directory.
CODEX_WORKER_WORKTREE_ROOT=
# Git-connected deployment health targets keyed by exact project alias.
# Example: {"threadwise":{"provider":"render","healthUrl":"https://example.onrender.com/health","expectedService":"threadwise"}}
THREADWISE_DEPLOY_TARGETS=
CODEX_DEPLOY_HEALTH_TIMEOUT_MS=1200000
# Owner-only /files courier. Laptop-only; never set roots on Render.
# Semicolon-separated explicit directories. A full drive is allowed only when you
# deliberately name it, for example C:\;D:\, and is never inferred.
THREADWISE_FILE_ROOTS=
THREADWISE_FILE_MAX_BYTES=50000000
# Bounded fallback when Windows Search has not indexed a requested root.
THREADWISE_FILE_SCAN_LIMIT=50000
# Trusted host publishing timeouts. Git/GitHub commands run only in the laptop
# worker after the sandboxed Codex turn has ended.
CODEX_PUBLISH_CHECK_TIMEOUT_MS=900000
CODEX_PUBLISH_GITHUB_TIMEOUT_MS=1800000
# Optional absolute Codex CLI path for app-server task discovery. Normally the SDK's bundled CLI is used.
CODEX_WORKER_EXECUTABLE=
# Legacy laptop-worker settings remain for owner-only Ideas Intelligence. They
# do not execute Study analysis and do not need to be configured for Study mode.
# "auto" uses the best model available to the locally configured Gemini CLI.
GEMINI_WORKER_MODEL=auto
GEMINI_WORKER_TIMEOUT_MS=600000
# Optional absolute working directory used for read-only Gemini prompts.
GEMINI_WORKER_WORKING_DIRECTORY=
# Optional absolute Gemini CLI JavaScript entry file. Normally global npm discovery is automatic.
GEMINI_WORKER_EXECUTABLE=

# Optional least-privilege catalog sidecar. This process can only update Codex
# project/task metadata; it cannot claim jobs, download files, or report results.
CODEX_TASK_SYNC_PRIVATE_KEY_PATH=D:\path\to\threadwise-codex-task-sync-ed25519.pem
