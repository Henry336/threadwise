generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  OPEN
  DONE
  CANCELED
}

enum TaskImportStatus {
  PENDING
  IMPORTING
  PARTIAL
  IMPORTED
  CANCELED
  EXPIRED
}

enum TaskImportItemStatus {
  READY
  IMPORTED
  SKIPPED
  FAILED
}

enum IdeaStatus {
  RAW
  CLARIFIED
  SELECTED
  PROTOTYPING
  BUILT
  PAUSED
  REJECTED
}

enum ReminderMode {
  INDIVIDUAL
  DIGEST
}

enum RecurrenceRule {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum CaptureKind {
  IDEA
  TASK
  REFLECTION
  NOTE
  NOISE
}

enum PlanningScope {
  PERSONAL
  GROUP
  STUDY
}

enum TaskCaptureDraftStatus {
  COLLECTING
  REVIEWING
  COMMITTING
  COMMITTED
  CANCELED
  EXPIRED
}

enum TaskCaptureDraftItemStatus {
  READY
  NEEDS_REVIEW
}

enum DailyBriefKind {
  MORNING
  EVENING
  GROUP_DIGEST
}

enum DailyBriefDeliveryStatus {
  PENDING
  SENT
  SKIPPED
  FAILED
}

enum GroupMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum GroupMemberStatus {
  ACTIVE
  LEFT
  KICKED
}

enum TaskAssigneeStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

enum GroupActivityType {
  TASK_CREATED
  TASK_UPDATED
  TASK_COMPLETED
  TASK_REOPENED
  TASK_ARCHIVED
  TASK_ASSIGNED
  TASK_UNASSIGNED
  ASSIGNMENT_ACCEPTED
  ASSIGNMENT_DECLINED
  TASK_BLOCKED
  TASK_UNBLOCKED
  TASK_HANDED_OFF
  SCHEDULE_CREATED
  SCHEDULE_FINALIZED
  SCHEDULE_CANCELED
}

enum AvailabilityPollStatus {
  OPEN
  FINALIZED
  CANCELED
}

enum CodexJobStatus {
  WAITING_APPROVAL
  PENDING
  RUNNING
  COMPLETED
  FAILED
  BLOCKED
  CANCELED
}

enum CodexApprovalStatus {
  PENDING
  APPROVED
  DENIED
}

enum FileCourierJobKind {
  SEARCH
  RECENT
  LOOKUP
  SEND
}

enum FileCourierJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELED
}

enum VoiceCleanupMode {
  VERBATIM
  LIGHT
}

enum VoiceTranscriptionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  UNDONE
}

enum StudyTrafficLight {
  GREEN
  AMBER
  RED
  UNASSESSED
}

enum StudyItemType {
  LECTURE
  TUTORIAL
  LAB
  ASSIGNMENT
  PROJECT
  REVISION
  TIMED_PRACTICE
  READING
  ADMINISTRATIVE
}

enum StudyItemStatus {
  OPEN
  IN_PROGRESS
  PROCESSED
  DONE
  SKIPPED
}

enum StudyPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum StudyMistakeCategory {
  CONCEPTUAL_MISUNDERSTANDING
  WRONG_APPROACH
  EXECUTION_CARELESS
  TIME_MANAGEMENT
}

enum StudyMistakeStatus {
  OPEN
  REATTEMPT_DUE
  RESOLVED
}

enum StudyReminderKind {
  WEEKLY_REVIEW
  WEEKLY_REVIEW_INCOMPLETE
  WEEKLY_PREVIEW
  MISTAKE_REATTEMPT
  MODULE_RED
  DEADLINE_APPROACHING
  ITEM_OVERDUE
  STUDY_BLOCK
  TIMED_PRACTICE_MISSING
  DAY_PREVIEW
  CLASS_DEPARTURE
  CLASS_FOLLOW_UP
  CANVAS_MISSING_REVIEW
  CANVAS_SYNC_ERROR
}

enum StudyItemSource {
  MANUAL
  CANVAS
}

enum StudyResourceKind {
  NOTE
  IMAGE
  LINK
  FILE
  QUESTION
}

enum TaskAudience {
  UNASSIGNED
  EVERYONE
  ASSIGNEES
}

enum TaskReminderScheduleStatus {
  PENDING
  PROCESSING
  SENT
  CANCELED
}

enum StudyAnalysisMode {
  CONNECTIONS
  QUIZ
  BOTH
}

enum StudyNoteEditSuggestionStatus {
  PENDING
  APPLIED
  DISMISSED
  SUPERSEDED
}

enum StudyCaptureBatchStatus {
  COLLECTING
  SENDING
  REVIEW
  PROCESSING
  COMPLETED
  EXPIRING
  EXPIRED
}

enum ImageUploadBatchStatus {
  COLLECTING
  SENDING
  REVIEW
  PROCESSING
  COMPLETED
  EXPIRING
  EXPIRED
}

enum StudyCanvasSyncStatus {
  NEVER
  RUNNING
  READY
  ERROR
}

enum StudyCanvasAssignmentStatus {
  ACTIVE
  SUBMITTED
  MISSING
}

enum StudyCanvasMaterialKind {
  PAGE
  FILE
  ASSIGNMENT
  QUIZ
  DISCUSSION
  EXTERNAL_URL
  OTHER
}

enum CommunityEnvironment {
  TEST
  PRODUCTION
}

enum CommunityModeratorStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum CommunityTriggerMatchType {
  WORD
  PHRASE
  DOMAIN
}

enum CommunityModerationActionType {
  REVIEW
  WARN
  DELETE
  MUTE
  BAN
}

enum CommunityReportStatus {
  OPEN
  DISMISSED
  ACTIONED
}

enum CommunityOffenceSeverity {
  MINOR
  MODERATE
  SERIOUS
  CRITICAL
}

enum CommunityOffenceStatus {
  PENDING
  ACTIVE
  PARDONED
  REJECTED
}

model User {
  id         String   @id @default(uuid())
  telegramId String   @unique
  username   String?
  firstName  String?
  lastName   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  settings                   UserSettings?
  ideas                      Idea[]
  tasks                      Task[]
  notes                      Note[]
  noteCaptureSession         NoteCaptureSession?
  reflections                Reflection[]
  pendingCaptures            PendingCapture[]
  pendingNoteMerges          PendingNoteMerge[]
  pendingItemEdits           PendingItemEdit[]
  pendingBulkActions         PendingBulkAction[]
  pendingSearches            PendingSearch[]
  pendingGmailOAuth          PendingGmailOAuth[]
  gmailConnection            GmailConnection?
  gmailSummaries             GmailMessageSummary[]
  pendingCalendarOAuth       PendingCalendarOAuth[]
  calendarConnection         CalendarConnection?
  pendingImageCaptures       PendingImageCapture[]
  pendingImageUploads        PendingImageUpload[]
  pendingImageUploadBatches  PendingImageUploadBatch[]
  storedImages               StoredImage[]
  pendingExpenses            PendingExpense[]
  expenses                   Expense[]
  pendingMicrosoftOAuth      PendingMicrosoftOAuth[]
  microsoftConnection        MicrosoftConnection?
  reminderHistory            ReminderDelivery[]
  taskReminderSchedules      TaskReminderSchedule[]
  taskControlSurfaces        TaskControlSurface[]
  auditLogs                  AuditLog[]
  availabilityCalendarEvents AvailabilityCalendarEvent[]
  groupWorkspace             GroupWorkspace?             @relation("GroupWorkspaceOwner")
  geminiIdeaJobs             GeminiIdeaJob[]
  voiceTranscriptionJobs     VoiceTranscriptionJob[]
  pendingTaskImports         PendingTaskImport[]
  studyWorkspace             StudyWorkspace?
  studyNoteDrafts            StudyNoteDraft[]
  personalNoteDrafts         PersonalNoteDraft[]
  taskCaptureDrafts          TaskCaptureDraft[]
  dailyBriefDeliveries       DailyBriefDelivery[]
  dailyAgendaOrderStates     DailyAgendaOrderState[]
}

model StudyWorkspace {
  id                         String    @id @default(uuid())
  ownerUserId                String    @unique
  ownerTelegramId            String    @unique
  boundChatId                String?   @unique
  semesterName               String    @default("NUS semester")
  semesterStartDate          DateTime?
  timezone                   String    @default("Asia/Singapore")
  active                     Boolean   @default(false)
  weeklyReviewDay            Int       @default(6)
  weeklyReviewTime           String    @default("20:30")
  weeklyPreviewDay           Int       @default(7)
  weeklyPreviewTime          String    @default("19:00")
  quietHoursStart            String?   @default("01:30")
  quietHoursEnd              String?   @default("09:00")
  maxRemindersPerDay         Int       @default(4)
  timedPracticeStartWeek     Int       @default(4)
  studyBlockRemindersEnabled Boolean   @default(false)
  canvasSyncEnabled          Boolean   @default(true)
  activeModuleId             String?
  activeModuleUntil          DateTime?
  activeOriginId             String?
  activeOriginUntil          DateTime?
  travelMutedUntil           DateTime?
  lastReminderCheckAt        DateTime?
  lastReminderStatus         String?
  lastReminderSummary        Json?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  owner                 User                       @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  modules               StudyModule[]              @relation("StudyWorkspaceModules")
  activeModule          StudyModule?               @relation("StudyWorkspaceActiveModule", fields: [activeModuleId], references: [id], onDelete: SetNull)
  weeks                 StudyWeek[]
  items                 StudyItem[]
  sessions              StudySession[]
  mistakes              StudyMistake[]
  weeklyReviews         WeeklyReview[]
  scheduleBlocks        StudyScheduleBlock[]
  conversation          StudyConversation?
  reminderDeliveries    StudyReminderDelivery[]
  travelReminderStates  StudyTravelReminderState[]
  resources             StudyResource[]
  noteRevisions         StudyResourceRevision[]
  noteLinks             StudyNoteLink[]
  pendingCaptures       StudyPendingCapture[]
  pendingCaptureBatches StudyPendingCaptureBatch[]
  analysisJobs          GeminiStudyAnalysisJob[]
  noteEditSuggestions   StudyNoteEditSuggestion[]
  noteCaptureSession    StudyNoteCaptureSession?
  noteDrafts            StudyNoteDraft[]
  taskCaptureDrafts     TaskCaptureDraft[]
  canvasSync            StudyCanvasSync?
  canvasAssignments     StudyCanvasAssignment[]
  canvasCourseModules   StudyCanvasCourseModule[]
  canvasMaterials       StudyCanvasMaterial[]
  origins               StudyLocationOrigin[]      @relation("StudyWorkspaceOrigins")
  activeOrigin          StudyLocationOrigin?       @relation("StudyWorkspaceActiveOrigin", fields: [activeOriginId], references: [id], onDelete: SetNull)

  @@index([active, boundChatId])
  @@index([activeModuleId, activeModuleUntil])
  @@index([activeOriginId, activeOriginUntil])
}

model StudyModule {
  id                String            @id @default(uuid())
  workspaceId       String
  code              String
  name              String
  active            Boolean           @default(true)
  displayOrder      Int               @default(0)
  color             String?
  workloadGroup     String?
  canvasCourseId    String?
  canvasCourseName  String?
  canvasTermId      String?
  canvasTermName    String?
  canvasTermStartAt DateTime?
  canvasTermEndAt   DateTime?
  canvasLastSeenAt  DateTime?
  userArchivedAt    DateTime?
  currentMastery    StudyTrafficLight @default(UNASSESSED)
  masteryReason     String?
  redSince          DateTime?
  lastRedWarningAt  DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  workspace             StudyWorkspace             @relation("StudyWorkspaceModules", fields: [workspaceId], references: [id], onDelete: Cascade)
  activeFor             StudyWorkspace[]           @relation("StudyWorkspaceActiveModule")
  items                 StudyItem[]
  sessions              StudySession[]
  mistakes              StudyMistake[]
  scheduleBlocks        StudyScheduleBlock[]
  resources             StudyResource[]
  pendingCaptures       StudyPendingCapture[]
  pendingCaptureBatches StudyPendingCaptureBatch[]
  noteCaptureSessions   StudyNoteCaptureSession[]
  canvasAssignments     StudyCanvasAssignment[]
  canvasCourseModules   StudyCanvasCourseModule[]
  canvasMaterials       StudyCanvasMaterial[]
  analysisJobs          GeminiStudyAnalysisJob[]
  noteEditSuggestions   StudyNoteEditSuggestion[]
  noteDrafts            StudyNoteDraft[]

  @@unique([workspaceId, code])
  @@unique([workspaceId, canvasCourseId])
  @@index([workspaceId, active, displayOrder])
  @@index([workspaceId, currentMastery])
}

model StudyWeek {
  id              String            @id @default(uuid())
  workspaceId     String
  number          Int
  startDate       DateTime
  endDate         DateTime
  overallStatus   StudyTrafficLight @default(UNASSESSED)
  reviewCompleted Boolean           @default(false)
  topPriorities   String[]
  reflection      String?
  overloadNotes   String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  workspace StudyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items     StudyItem[]
  review    WeeklyReview?

  @@unique([workspaceId, number])
  @@index([workspaceId, startDate, endDate])
}

model StudyItem {
  id              String            @id @default(uuid())
  workspaceId     String
  moduleId        String
  weekId          String?
  publicId        String
  type            StudyItemType
  title           String
  notes           String?
  source          StudyItemSource   @default(MANUAL)
  titleOverridden Boolean           @default(false)
  dueAtOverridden Boolean           @default(false)
  status          StudyItemStatus   @default(OPEN)
  priority        StudyPriority     @default(NORMAL)
  dueAt           DateTime?
  plannedFor      DateTime?         @db.Date
  firstPlannedFor DateTime?         @db.Date
  plannedMinutes  Int?
  actualMinutes   Int               @default(0)
  mastery         StudyTrafficLight @default(UNASSESSED)
  masteryReason   String?
  processedAt     DateTime?
  completedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  workspace        StudyWorkspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  module           StudyModule            @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  week             StudyWeek?             @relation(fields: [weekId], references: [id], onDelete: SetNull)
  sessions         StudySession[]
  mistakes         StudyMistake[]
  canvasAssignment StudyCanvasAssignment?

  @@unique([workspaceId, publicId])
  @@index([workspaceId, status, dueAt])
  @@index([workspaceId, status, plannedFor])
  @@index([moduleId, status, createdAt])
  @@index([weekId, status])
  @@index([workspaceId, mastery])
}

model StudySession {
  id              String    @id @default(uuid())
  workspaceId     String
  moduleId        String
  itemId          String?
  startedAt       DateTime
  endedAt         DateTime?
  durationMinutes Int?
  method          String
  topic           String?
  focusStructure  String?
  techniques      String[]  @default([])
  result          String?
  topicsMixed     String[]
  attemptedScore  Float?
  maximumScore    Float?
  usedNotes       Boolean?
  timed           Boolean   @default(false)
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace StudyWorkspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  module    StudyModule            @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  item      StudyItem?             @relation(fields: [itemId], references: [id], onDelete: SetNull)
  resources StudySessionResource[]

  @@index([workspaceId, startedAt])
  @@index([workspaceId, endedAt])
  @@index([moduleId, timed, startedAt])
  @@index([workspaceId, archivedAt, startedAt])
}

model StudyMistake {
  id             String               @id @default(uuid())
  workspaceId    String
  moduleId       String
  itemId         String?
  publicId       String
  source         String
  category       StudyMistakeCategory
  cause          String
  prevention     String
  firstAttemptAt DateTime
  revisitAt      DateTime?
  status         StudyMistakeStatus   @default(OPEN)
  resolvedAt     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  workspace StudyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  module    StudyModule    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  item      StudyItem?     @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, publicId])
  @@index([workspaceId, status, revisitAt])
  @@index([moduleId, status])
}

model WeeklyReview {
  id                     String   @id @default(uuid())
  workspaceId            String
  weekId                 String   @unique
  moduleStatuses         Json
  wins                   String[]
  unresolvedTopics       String[]
  nextWeekPriorities     String[]
  lostTimeCauses         String[]
  overloadNotes          String?
  workloadCompatible     Boolean?
  protectedOverflowBlock String?
  summary                String?
  completedAt            DateTime
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  workspace StudyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  week      StudyWeek      @relation(fields: [weekId], references: [id], onDelete: Cascade)

  @@index([workspaceId, completedAt])
}

model StudyScheduleBlock {
  id                  String     @id @default(uuid())
  workspaceId         String
  moduleId            String?
  dayOfWeek           Int
  startTime           String
  endTime             String
  startWeek           Int?
  endWeek             Int?
  label               String
  blockType           String
  customTypeLabel     String?
  venueId             String?
  venueName           String?
  destinationStopId   String?
  preparation         String[]   @default([])
  defaultOriginId     String?
  travelBufferMinutes Int        @default(15)
  reminderLeadMinutes Int        @default(10)
  source              String     @default("MANUAL")
  sourceRef           String?
  recurrenceStartDate DateTime?
  recurrenceEndDate   DateTime?
  excludedDates       DateTime[] @default([])
  excludedWeeks       Int[]      @default([])
  active              Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  workspace     StudyWorkspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  module        StudyModule?               @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  defaultOrigin StudyLocationOrigin?       @relation(fields: [defaultOriginId], references: [id], onDelete: SetNull)
  travelStates  StudyTravelReminderState[]

  @@unique([workspaceId, source, sourceRef])
  @@index([workspaceId, active, dayOfWeek])
  @@index([defaultOriginId])
}

model StudyResource {
  id                       String            @id @default(uuid())
  workspaceId              String
  moduleId                 String
  publicId                 String
  kind                     StudyResourceKind
  title                    String
  body                     String?
  url                      String?
  tags                     String[]          @default([])
  telegramFileId           String?
  telegramUniqueId         String?
  mediaKind                String?
  mimeType                 String?
  fileName                 String?
  fileSize                 Int?
  caption                  String?
  ocrText                  String?
  analysisExcerpt          String?
  analysisExcerptReady     Boolean           @default(false)
  analysisExcerptTruncated Boolean           @default(false)
  captionPreview           String?
  ocrPreview               String?
  ocrPreviewTruncated      Boolean           @default(false)
  wikiLookupKeys           String[]          @default([])
  searchTokens             String[]          @default([])
  ocrConfidence            Float?
  sourceMessageId          Int?
  sourceSenderTelegramId   String?
  sourceSentAt             DateTime?
  pinnedAt                 DateTime?
  archivedAt               DateTime?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  workspace           StudyWorkspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  module              StudyModule               @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  sessions            StudySessionResource[]
  noteEditSuggestions StudyNoteEditSuggestion[]
  revisions           StudyResourceRevision[]
  outgoingNoteLinks   StudyNoteLink[]           @relation("StudyNoteLinkSource")
  incomingNoteLinks   StudyNoteLink[]           @relation("StudyNoteLinkTarget")
  noteDrafts          StudyNoteDraft[]

  @@unique([workspaceId, publicId])
  @@unique([workspaceId, telegramUniqueId])
  @@index([workspaceId, kind, createdAt])
  @@index([moduleId, kind, pinnedAt, createdAt])
  @@index([workspaceId, archivedAt])
  @@index([wikiLookupKeys], type: Gin)
  @@index([searchTokens], type: Gin)
}

model StudyNoteDraft {
  id                String    @id @default(uuid())
  workspaceId       String
  ownerUserId       String
  draftKey          String
  resourceId        String?
  resourceUpdatedAt DateTime?
  moduleId          String?
  title             String    @default("")
  body              String    @default("")
  revision          Int       @default(1)
  expiresAt         DateTime
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workspace StudyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User           @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  resource  StudyResource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  module    StudyModule?   @relation(fields: [moduleId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, draftKey])
  @@index([ownerUserId, expiresAt])
  @@index([workspaceId, updatedAt])
}

model StudyResourceRevision {
  id          String   @id @default(uuid())
  workspaceId String
  resourceId  String
  title       String
  body        String
  tags        String[] @default([])
  source      String   @default("DASHBOARD")
  createdAt   DateTime @default(now())

  workspace StudyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  resource  StudyResource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId, createdAt])
  @@index([workspaceId, createdAt])
}

model StudyNoteLink {
  id               String   @id @default(uuid())
  workspaceId      String
  sourceResourceId String
  targetResourceId String
  createdAt        DateTime @default(now())

  workspace StudyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source    StudyResource  @relation("StudyNoteLinkSource", fields: [sourceResourceId], references: [id], onDelete: Cascade)
  target    StudyResource  @relation("StudyNoteLinkTarget", fields: [targetResourceId], references: [id], onDelete: Cascade)

  @@unique([sourceResourceId, targetResourceId])
  @@index([workspaceId, targetResourceId])
}

model StudySessionResource {
  sessionId  String
  resourceId String
  addedAt    DateTime @default(now())

  session  StudySession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  resource StudyResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([sessionId, resourceId])
  @@index([resourceId])
}

model StudyPendingCapture {
  id                     String             @id @default(uuid())
  token                  String             @unique
  workspaceId            String
  moduleId               String?
  sourceText             String?
  telegramFileId         String?
  telegramUniqueId       String?
  mediaKind              String?
  mimeType               String?
  fileName               String?
  fileSize               Int?
  sourceMessageId        Int?
  sourceSenderTelegramId String?
  sourceSentAt           DateTime?
  selectedKind           StudyResourceKind?
  ocrText                String?
  ocrConfidence          Float?
  batchId                String?
  batchPosition          Int?
  expiresAt              DateTime
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  workspace StudyWorkspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  module    StudyModule?              @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  batch     StudyPendingCaptureBatch? @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([workspaceId, expiresAt])
  @@index([batchId, batchPosition])
}

model StudyPendingCaptureBatch {
  id                   String                  @id @default(uuid())
  token                String                  @unique
  workspaceId          String
  moduleId             String?
  telegramMediaGroupId String
  chatId               String
  sharedCaption        String?
  status               StudyCaptureBatchStatus @default(COLLECTING)
  readyAt              DateTime
  expiresAt            DateTime
  leaseExpiresAt       DateTime?
  reviewMessageId      Int?
  completedAt          DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  workspace StudyWorkspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  module    StudyModule?          @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  captures  StudyPendingCapture[]

  @@unique([workspaceId, telegramMediaGroupId])
  @@index([status, readyAt, leaseExpiresAt])
  @@index([status, expiresAt])
}

model StudyNoteCaptureSession {
  id          String   @id @default(uuid())
  workspaceId String   @unique
  moduleId    String
  chatId      String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace StudyWorkspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  module    StudyModule               @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  segments  StudyNoteCaptureSegment[]

  @@index([expiresAt])
}

model StudyNoteCaptureSegment {
  id                String   @id @default(uuid())
  sessionId         String
  telegramMessageId Int
  text              String
  createdAt         DateTime @default(now())

  session StudyNoteCaptureSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, telegramMessageId])
  @@index([sessionId, createdAt])
}

model StudyCanvasSync {
  id                  String                @id @default(uuid())
  workspaceId         String                @unique
  status              StudyCanvasSyncStatus @default(NEVER)
  canvasUserId        String?
  canvasUserName      String?
  lastAttemptAt       DateTime?
  lastSuccessfulAt    DateTime?
  nextSyncAt          DateTime              @default(now())
  lastError           String?
  lastSummary         Json?
  consecutiveFailures Int                   @default(0)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  workspace StudyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status, nextSyncAt])
}

