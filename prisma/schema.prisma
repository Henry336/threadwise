  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt

  group    CommunityGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  triggers CommunityTrigger[]

  @@unique([groupId, normalizedName])
  @@index([groupId, enabled])
}

model CommunityTrigger {
  id                   String                    @id @default(uuid())
  groupId              String
  triggerGroupId       String
  pattern              String
  normalizedPattern    String
  matchType            CommunityTriggerMatchType @default(PHRASE)
  language             String                    @default("ANY")
  createdByTelegramId  String
  pendingApproval      Boolean                   @default(false)
  approvedByTelegramId String?
  approvedAt           DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  group        CommunityGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  triggerGroup CommunityTriggerGroup @relation(fields: [triggerGroupId], references: [id], onDelete: Cascade)

  @@unique([groupId, normalizedPattern])
  @@index([triggerGroupId])
}

model CommunityTrustedMember {
  id                String   @id @default(uuid())
  groupId           String
  telegramId        String
  username          String?
  displayName       String?
  note              String?
  addedByTelegramId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  group CommunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, telegramId])
  @@index([telegramId])
}

model CommunityMember {
  id          String    @id @default(uuid())
  groupId     String
  telegramId  String
  username    String?
  displayName String?
  active      Boolean   @default(true)
  joinedAt    DateTime  @default(now())
  leftAt      DateTime?
  lastSeenAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  group CommunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, telegramId])
  @@index([groupId, active, joinedAt])
}

model CommunityReport {
  id                    String                @id @default(uuid())
  groupId               String
  sourceChatId          String
  sourceMessageId       Int
  sourceMessageThreadId Int?
  sourceTopicName       String?
  reportedTelegramId    String?
  reportedUsername      String?
  reportedDisplayName   String?
  evidenceText          String?
  evidenceExpiresAt     DateTime
  reason                String?
  status                CommunityReportStatus @default(OPEN)
  reportCount           Int                   @default(1)
  moderatorChatId       String?
  moderatorMessageId    Int?
  resolvedByTelegramId  String?
  resolvedAt            DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  group     CommunityGroup            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  reporters CommunityReportReporter[]
  offence   CommunityOffence?

  @@unique([groupId, sourceMessageId])
  @@index([groupId, status, createdAt])
}

model CommunitySeverityRule {
  id        String                   @id @default(uuid())
  groupId   String
  severity  CommunityOffenceSeverity
  points    Int
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  group CommunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, severity])
  @@index([groupId])
}

model CommunityOffence {
  id                    String                   @id @default(uuid())
  groupId               String
  reportId              String?                  @unique
  targetTelegramId      String
  targetUsername        String?
  targetDisplayName     String?
  sourceChatId          String
  sourceMessageId       Int?
  sourceMessageThreadId Int?
  sourceTopicName       String?
  categoryName          String?
  severity              CommunityOffenceSeverity
  policyPoints          Int
  proposedPoints        Int
  proposedByTelegramId  String
  proposalReason        String?
  appliedPoints         Int?
  status                CommunityOffenceStatus   @default(PENDING)
  confirmedByTelegramId String?
  confirmedAt           DateTime?
  pardonedByTelegramId  String?
  pardonedAt            DateTime?
  pardonReason          String?
  permanentBanApplied   Boolean                  @default(false)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  group  CommunityGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  report CommunityReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([groupId, targetTelegramId, status, createdAt])
  @@index([groupId, status, createdAt])
}

model CommunityForumTopic {
  id                 String   @id @default(uuid())
  groupId            String
  messageThreadId    Int
  name               String
  iconColor          Int?
  iconCustomEmojiId  String?
  active             Boolean  @default(true)
  replacedByThreadId Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  group CommunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, messageThreadId])
  @@index([groupId, active])
}

model CommunityReportReporter {
  id                 String   @id @default(uuid())
  reportId           String
  reporterTelegramId String
  createdAt          DateTime @default(now())

  report CommunityReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, reporterTelegramId])
  @@index([reporterTelegramId])
}

model CommunityModerationAction {
  id                    String                        @id @default(uuid())
  groupId               String
  actorTelegramId       String
  targetTelegramId      String?
  action                CommunityModerationActionType
  source                String
  sourceMessageId       Int?
  sourceMessageThreadId Int?
  sourceTopicName       String?
  reportId              String?
  reason                String?
  muteUntil             DateTime?
  reversible            Boolean                       @default(false)
  undoneAt              DateTime?
  undoneByTelegramId    String?
  createdAt             DateTime                      @default(now())

  group CommunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
  @@index([targetTelegramId, createdAt])
}

model CommunityAudit {
  id                      String   @id @default(uuid())
  groupId                 String
  actorTelegramId         String
  action                  String
  targetTelegramId        String?
  details                 Json?
  ownerNotificationStatus String?
  createdAt               DateTime @default(now())

  group CommunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
  @@index([actorTelegramId, createdAt])
}

model CommunityConversation {
  id              String   @id @default(uuid())
  groupId         String
  actorTelegramId String
  kind            String
  step            String
  data            Json
  messageId       Int?
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  group CommunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, actorTelegramId])
  @@index([expiresAt])
}

model CommunityControlSession {
  actorTelegramId      String                         @id
  selectedGroupId      String
  triggerSearchQuery   String?
  triggerActionFilter  CommunityModerationActionType?
  triggerGroupFilterId String?
  triggerPage          Int                            @default(0)
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt

  selectedGroup CommunityGroup @relation(fields: [selectedGroupId], references: [id], onDelete: Cascade)

  @@index([selectedGroupId])
}

model CommunityProcessedUpdate {
  updateId  Int      @id
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model DashboardRequestReplay {
  fingerprint          String   @id
  principalFingerprint String
  operation            String
  expiresAt            DateTime
  createdAt            DateTime @default(now())

  @@index([expiresAt])
}

model SharedRateLimitBucket {
  bucketKey            String   @id
  principalFingerprint String
  routeClass           String
  windowStartedAt      DateTime
  requestCount         Int      @default(1)
  expiresAt            DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([expiresAt])
  @@index([principalFingerprint, routeClass, windowStartedAt])
}
